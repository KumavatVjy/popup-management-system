# Application Configuration
APP_NAME=popup-manager
APP_ENV=development
APP_PORT=8082

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=popup_management_db
DB_USER=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=change_me_to_a_secure_random_string_in_production
JWT_EXPIRE_HOURS=24

# Initial Admin Seeding (Optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Public CORS Allowed Origins (Comma-separated client domains)
PUBLIC_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Dedicated Disposable Test Database Configuration (Used exclusively for database integration tests)
# TEST_DATABASE_DSN=root:@tcp(127.0.0.1:3306)/popup_management_test?charset=utf8mb4&parseTime=True&loc=Local
